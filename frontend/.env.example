# Copy to frontend/.env.local. Anything prefixed NEXT_PUBLIC_ is visible to every visitor.
# Reference: docs/09-config/01-environment-variables.md

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
# Server-side fetches; defaults to NEXT_PUBLIC_API_BASE_URL
API_BASE_URL_INTERNAL=

NEXT_PUBLIC_ENV=development

# Phase 3
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
REVALIDATE_SECRET=

NEXT_PUBLIC_SENTRY_DSN=

# Phase 5: shows "Book now" on tour pages (needs PAYMENTS_PROVIDER=stub or razorpay on the API)
NEXT_PUBLIC_FEATURE_BOOKING=true
