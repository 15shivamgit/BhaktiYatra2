# Copy to backend/.env and fill in. Never commit backend/.env.
# Full reference: docs/09-config/01-environment-variables.md

NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Use a dedicated dev database, never the production one.
MONGO_URL=

FRONTEND_URLS=http://localhost:3000
SITE_URL=http://localhost:3000

RATE_LIMIT_ENABLED=true
JOBS_ENABLED=true

# Phase 2 (auth). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# Google sign-in (optional). Create an OAuth client in Google Cloud Console and register
# GOOGLE_REDIRECT_URI there as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Phase 3 (content, images)
REVALIDATE_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bhaktiyatra/dev

# Phase 5 (bookings)
HOLD_MINUTES=15
MAX_SEATS_PER_BOOKING=10

# Payments: stub until Phase 6 wires Razorpay; production refuses the stub
PAYMENTS_PROVIDER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Phase 7 (documents, email)
TICKET_SIGNING_SECRET=
RESEND_API_KEY=
MAIL_FROM=
MAIL_REPLY_TO=
ADMIN_NOTIFY_EMAIL=

SENTRY_DSN=
